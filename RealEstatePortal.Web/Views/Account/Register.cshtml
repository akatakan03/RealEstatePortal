@model RealEstatePortal.Web.Models.Account.RegisterViewModel
@{
    ViewData["Title"] = L["Register"].Value;
}

<div class="form-page">
    <div class="container">
        <div class="form-shell narrow">
            <div class="auth-lead">
                <h1>@L["List your property"]</h1>
                <p>@L["Create an agent account to publish and manage listings."]</p>
            </div>
            <div class="form-card">
                @if (TempData["AuthError"] is string authErr)
                {
                    <div class="alert alert-danger">@L[authErr]</div>
                }
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="All" class="text-danger" style="margin-bottom:1rem;"></div>

                    <div class="mb-field">
                        <label class="form-label">@L["I'm here to…"]</label>
                        <div style="display:flex;gap:1rem;">
                            <label class="choice-box">
                                <input type="radio" asp-for="Role" value="Member" /> @L["Find a property"]
                            </label>
                            <label class="choice-box">
                                <input type="radio" asp-for="Role" value="Agent" /> @L["List properties"]
                            </label>
                        </div>
                    </div>
                    <div class="mb-field">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-field">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="mb-field">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-field check-field">
                        <label class="check-row">
                            <input asp-for="EmailNotifications" />
                            <span>@L["Email me about new matches and price drops"]</span>
                        </label>
                    </div>
                    <div class="mb-field check-field">
                        <label class="check-row">
                            <input asp-for="AcceptTerms" />
                            @* The link opens the terms in a new tab so the half-filled form isn't lost. *@
                            <span>@Html.Raw(L["I accept {0}.", $"<a href=\"{Url.Action("Terms", "Home")}\" target=\"_blank\" rel=\"noopener\">{L["the terms of use"].Value}</a>"])</span>
                        </label>
                        <span asp-validation-for="AcceptTerms" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width:100%;margin-top:.5rem;">@L["Create account"]</button>
                </form>

                <partial name="_ExternalLogins" />
            </div>
            <p class="auth-alt">@L["Already have an account?"] <a asp-action="Login">@L["Sign in"]</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@{
    ViewData["Title"] = L["Terms of use"].Value;
}
<div class="form-page">
    <div class="container" style="max-width:760px;">
        <h1 class="page-title">@L["Terms of use"]</h1>
        <p class="lead">@L["A short summary of the rules for using this site."]</p>

        <div class="detail-desc" style="margin-top:1rem;">
            <p>@L["By creating an account you agree to use the site lawfully and to keep your login details secure."]</p>
            <p>@L["Listings must describe real properties accurately. Misleading or fraudulent content may be removed."]</p>
            <p>@L["We store the data you provide to run the service, including your appointments and messages with agents."]</p>
            <p class="form-hint">@L["This is placeholder text — replace it with your final terms before launch."]</p>
        </div>
    </div>
</div>

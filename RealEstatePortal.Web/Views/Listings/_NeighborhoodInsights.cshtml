@using RealEstatePortal.Application.Listings.Queries.GetNeighborhoodInsights
@model NeighborhoodInsightsDto
@{
    // Stable category key -> (emoji, localized label). Unknown keys fall back to the raw key.
    (string Icon, string Label) CategoryMeta(string key) => key switch
    {
        "transit" => ("🚌", L["Public transport"].Value),
        "market" => ("🛒", L["Markets"].Value),
        "health" => ("🏥", L["Healthcare"].Value),
        "school" => ("🎓", L["Schools"].Value),
        _ => ("📍", key)
    };

    string WalkLabel(int s) =>
        s >= 90 ? L["Walking paradise"].Value :
        s >= 70 ? L["Very walkable"].Value :
        s >= 50 ? L["Somewhat walkable"].Value :
        s >= 25 ? L["Car-dependent"].Value :
                  L["Very car-dependent"].Value;

    var poiKm = (Model.PoiRadiusMeters / 1000.0).ToString("0.#");
}

<h3>@L["Neighborhood insights"]</h3>
<p class="ni-note">@L["Automatic estimates from public map data and our own listings — a starting point, not a guarantee."]</p>

<div class="ni-grid">
    @if (Model.PricePerSqm is not null)
    {
        var p = Model.PricePerSqm;
        var above = p.PercentVsMedian > 1;
        var below = p.PercentVsMedian < -1;
        var pct = Math.Abs(p.PercentVsMedian).ToString("0.#");
        <div class="ni-card">
            <div class="ni-card-title">@L["Price per m²"]</div>
            <div class="ni-price-value">@p.ListingPerSqm.ToString("N0") @p.Currency<span>/m²</span></div>
            <div class="ni-price-cmp @(above ? "is-above" : below ? "is-below" : "is-par")">
                @if (above)
                {
                    <text>@L["{0}% above the area median", pct]</text>
                }
                else if (below)
                {
                    <text>@L["{0}% below the area median", pct]</text>
                }
                else
                {
                    <text>@L["In line with the area median"]</text>
                }
            </div>
            <div class="ni-price-sub">
                @L["Area median"]: @p.AreaMedianPerSqm.ToString("N0") @p.Currency/m² · @L["{0} nearby listings", p.SampleSize]
            </div>
        </div>
    }

    @if (Model.WalkabilityScore is not null)
    {
        var s = Model.WalkabilityScore.Value;
        <div class="ni-card ni-walk @(s >= 70 ? "is-high" : s >= 50 ? "is-mid" : "is-low")">
            <div class="ni-card-title">@L["Walkability"]</div>
            <div class="ni-walk-score"><span class="ni-walk-num">@s</span><span class="ni-walk-max">/100</span></div>
            <div class="ni-walk-label">@WalkLabel(s)</div>
        </div>
    }
</div>

@if (Model.Amenities.Any())
{
    <div class="ni-amenities">
        <div class="ni-card-title">@L["Within {0} km", poiKm]</div>
        <ul class="ni-poi-list">
            @foreach (var a in Model.Amenities.OrderByDescending(a => a.Count))
            {
                var meta = CategoryMeta(a.Category);
                <li>
                    <span class="ni-poi-icon">@meta.Icon</span>
                    <span class="ni-poi-count">@a.Count</span>
                    <span class="ni-poi-label">@meta.Label</span>
                    @if (a.NearestMeters is not null)
                    {
                        <span class="ni-poi-nearest">@L["nearest {0} m", a.NearestMeters.Value]</span>
                    }
                </li>
            }
        </ul>
    </div>
}

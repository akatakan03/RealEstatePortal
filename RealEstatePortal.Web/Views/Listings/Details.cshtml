@model RealEstatePortal.Web.Models.Listings.ListingDetailViewModel
@{
    var listing = Model.Listing;
    ViewData["Title"] = listing.Title;

    // The description is rich text now — strip it to plain text for the meta/OG tags, which
    // must never carry markup, before truncating.
    var descriptionText = RealEstatePortal.Web.Helpers.HtmlText.ToPlainText(listing.Description);
    var metaDescription = descriptionText.Length > 160
        ? descriptionText.Substring(0, 157).TrimEnd() + "…"
        : descriptionText;
    var coverImage = listing.ImageUrls.FirstOrDefault();

    // The canonical points at this listing *in this language* — the alternates in the layout
    // are what tie the two versions together for a crawler.
    var culture = SupportedCultures.CodeOf(System.Globalization.CultureInfo.CurrentUICulture);
    var canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/{culture}/listing/{listing.Id}/{listing.Slug}";
}

@section Head {
    <meta name="description" content="@metaDescription" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@listing.Title" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    @if (coverImage is not null)
    {
        <meta property="og:image" content="@coverImage" />
    }
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<div class="detail">
    <div class="container">
        <a class="back-link" asp-action="Index">← @L["Back to listings"]</a>

        @if (listing.Status != RealEstatePortal.Domain.Enums.ListingStatus.Active)
        {
            @* The status sits inside the sentence rather than beside it: Turkish puts it in a
               different place, so a split-up version would read as nonsense. *@
            <div class="preview-banner">
                👁 @L["Preview — this listing is {0} and isn't visible to the public.", L.Localize(listing.Status)]
            </div>
        }

        @* The controller stores the English wording; it is translated here, where the request
           culture is known. The message has survived a redirect to reach this page. *@
        @if (TempData["InquirySuccess"] is string ok)
        {
            <div class="alert alert-success">@L[ok]</div>
        }

        @if (listing.ImageUrls.Any())
        {
            <div class="gallery">
                <div class="gallery-main">
                    <img id="mainImage" src="@listing.ImageUrls.First()" alt="@listing.Title" />
                    @if (listing.ImageUrls.Count > 1)
                    {
                        <button type="button" class="gallery-nav prev" onclick="stepGallery(-1)" aria-label="@L["Previous photo"]">‹</button>
                        <button type="button" class="gallery-nav next" onclick="stepGallery(1)" aria-label="@L["Next photo"]">›</button>
                    }
                </div>
                @if (listing.ImageUrls.Count > 1)
                {
                    <div class="gallery-thumbs">
                        @for (var i = 0; i < listing.ImageUrls.Count; i++)
                        {
                            <img src="@listing.ImageUrls[i]" data-full="@listing.ImageUrls[i]"
                                 class="@(i == 0 ? "active" : "")"
                                 onclick="selectThumb(this)" alt="@L["thumbnail"]" />
                        }
                    </div>
                }
            </div>
        }
        else if (Configuration.GetValue<bool>("Demo:PlaceholderImages"))
        {
            var seeds = ListingImages.PlaceholderSeeds(listing.Id, 5);
            <div class="gallery">
                <div class="gallery-main">
                    <img id="mainImage" src="https://loremflickr.com/1200/800/house?lock=@seeds[0]" alt="@listing.Title" />
                    <button type="button" class="gallery-nav prev" onclick="stepGallery(-1)" aria-label="@L["Previous photo"]">‹</button>
                    <button type="button" class="gallery-nav next" onclick="stepGallery(1)" aria-label="@L["Next photo"]">›</button>
                </div>
                <div class="gallery-thumbs">
                    @for (var i = 0; i < seeds.Count; i++)
                    {
                        <img src="https://loremflickr.com/300/200/house?lock=@seeds[i]"
                             data-full="https://loremflickr.com/1200/800/house?lock=@seeds[i]"
                             class="@(i == 0 ? "active" : "")"
                             onclick="selectThumb(this)"
                             alt="@L["thumbnail"]" loading="lazy" />
                    }
                </div>
            </div>
        }
        else
        {
            <div class="gallery-none">@L["No photos yet"]</div>
        }

        <div class="detail-grid">
            <div>
                <div class="detail-head">
                    <span class="eyebrow">@L.Localize(listing.PropertyType) · @L.Localize(listing.ListingType)</span>
                    <h1>@listing.Title</h1>
                    <div class="detail-price">@listing.PriceAmount.ToString("N0") @listing.PriceCurrency</div>

                    @* Interest signals. Every one of these is a counted row or a recorded price
                       change — nothing here is estimated, and weak numbers are left off rather
                       than shown, since "2 views" argues against the listing. *@
                    @if (listing.HasPriceDrop)
                    {
                        <div class="price-drop">
                            <span class="pd-arrow" aria-hidden="true">↓</span>
                            <strong>@L["{0}% lower", listing.PriceDropPercent.ToString("0.#")]</strong>
                            <span class="pd-was">
                                @L["was {0} {1}", listing.PreviousPrice.ToString("N0"), listing.PriceCurrency]
                                @if (listing.PriceDroppedAt is { } dropped)
                                {
                                    <text>· @dropped.Medium()</text>
                                }
                            </span>
                        </div>
                    }

                    @if (listing.IsNew || listing.ShowViews || listing.ShowSaves)
                    {
                        <ul class="interest-strip">
                            @if (listing.IsNew)
                            {
                                <li class="int-new">✨ @L["New this week"]</li>
                            }
                            @if (listing.ShowViews)
                            {
                                <li>👁 @L["{0} views in the last 7 days", listing.Views7d.ToString("N0")]</li>
                            }
                            @if (listing.ShowSaves)
                            {
                                <li>♥ @L["{0} people saved this", listing.SaveCount.ToString("N0")]</li>
                            }
                        </ul>
                    }
                    @if (User.Identity is not null && User.Identity.IsAuthenticated)
                    {
                        <form asp-controller="Favorites" asp-action="Toggle" method="post" style="margin-bottom:1.5rem;">
                            <input type="hidden" name="listingId" value="@listing.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="btn @(Model.IsFavorited ? "btn-primary" : "btn-ghost")">
                                @(Model.IsFavorited ? $"♥ {L["Saved"].Value}" : $"♡ {L["Save to favorites"].Value}")
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-ghost" style="margin-bottom:1.5rem;">♡ @L["Sign in to save"]</a>
                    }

                    @* Adds this listing to the compare set and shows the floating compare bar,
                       exactly like the toggle on a listing card. Needs no account, so it sits
                       outside the sign-in branch above. compare.js swaps the label via the
                       data-label attributes and reflects the saved state on load. *@
                    <button type="button" class="btn btn-ghost btn-compare-detail"
                            style="margin-bottom:1.5rem;"
                            data-compare-id="@listing.Id"
                            data-label="⇄ @L["Compare"]"
                            data-label-active="✓ @L["In comparison"]"
                            onclick="compareToggle(event, this)">⇄ @L["Compare"]</button>
                </div>

                @* A rental isn't financed with a mortgage, so the calculator is for sales only. *@
                @if (listing.ListingType == RealEstatePortal.Domain.Enums.ListingType.Sale)
                {
                    ViewData["MortgageRate"] = Model.MortgageMonthlyRate;
                    <partial name="_MortgageCalculator" model="listing" />
                }

                @{
                    var yes = L["Yes"].Value;
                    var no = L["No"].Value;
                }

                <div class="facts">
                    <div class="fact"><span class="value">@listing.Bedrooms</span><span class="lbl">@L["Bedrooms"]</span></div>
                    <div class="fact"><span class="value">@listing.Bathrooms</span><span class="lbl">@L["Bathrooms"]</span></div>
                    <div class="fact"><span class="value">@listing.AreaSqMeters.ToString("N0")</span><span class="lbl">@L["m² area"]</span></div>
                    @* "Listing type", not "Listing": the dashboard table has a column headed
                       with the latter meaning the listing itself, and one key cannot be both. *@
                    <div class="fact"><span class="value" style="font-size:1.05rem;">@L.Localize(listing.ListingType)</span><span class="lbl">@L["Listing type"]</span></div>
                </div>

                <div class="detail-section">
                    <h3>@L["Features"]</h3>
                    <div class="feature-list">
                        @if (listing.Heating is not null && listing.Heating != RealEstatePortal.Domain.Enums.HeatingType.None)
                        {
                            <div class="feature"><span class="fk">@L["Heating"]</span><span class="fv">@L.Localize(listing.Heating.Value)</span></div>
                        }
                        @if (listing.Internet is not null && listing.Internet != RealEstatePortal.Domain.Enums.InternetInfrastructure.Unknown)
                        {
                            <div class="feature"><span class="fk">@L["Internet"]</span><span class="fv">@L.Localize(listing.Internet.Value)</span></div>
                        }
                        @if (listing.FloorNumber is not null)
                        {
                            <div class="feature"><span class="fk">@L["Floor"]</span><span class="fv value">@listing.FloorNumber@(listing.TotalFloors is not null ? $" / {listing.TotalFloors}" : "")</span></div>
                        }
                        @if (listing.BuildingAge is not null)
                        {
                            <div class="feature"><span class="fk">@L["Building age"]</span><span class="fv"><span class="value">@listing.BuildingAge</span> @L["yrs"]</span></div>
                        }
                        @if (listing.MonthlyDues is not null)
                        {
                            <div class="feature"><span class="fk">@L["Monthly dues"]</span><span class="fv"><span class="value">@listing.MonthlyDues.Value.ToString("N0")</span> @listing.PriceCurrency</span></div>
                        }
                        <div class="feature"><span class="fk">@L["Furnished"]</span><span class="fv">@(listing.IsFurnished ? yes : no)</span></div>
                        <div class="feature"><span class="fk">@L["Balcony"]</span><span class="fv">@(listing.HasBalcony ? yes : no)</span></div>
                        <div class="feature"><span class="fk">@L["Parking"]</span><span class="fv">@(listing.HasParking ? yes : no)</span></div>
                    </div>
                </div>

                <div class="detail-section">
                    <h3>@L["About this property"]</h3>
                    @* Sanitized to a small tag allowlist on the way in (and again on read), so
                       rendering it raw here is safe and keeps the agent's formatting. *@
                    <div class="detail-desc">@Html.Raw(listing.Description)</div>
                </div>

                @await Html.PartialAsync("_PriceHistory", listing.PriceHistory)

                @if (!string.IsNullOrEmpty(listing.OwnerId))
                {
                    <a class="listed-by" href="@Url.AgentUrl(listing.OwnerId)">
                        <div class="lb-avatar">
                            @if (listing.OwnerAvatarUrl is not null)
                            {
                                <img src="@listing.OwnerAvatarUrl" alt="@listing.OwnerName" />
                            }
                            else
                            {
                                <span>@((listing.OwnerName ?? "A").Substring(0, 1).ToUpper())</span>
                            }
                        </div>
                        <div>
                            <div class="lb-label">@L["Listed by"]</div>
                            <div class="lb-name">@(listing.OwnerName ?? L["Agent"].Value)</div>
                        </div>
                    </a>
                }

                @if (TempData["AppointmentSuccess"] is string apptOk)
                {
                    <div class="alert alert-success">@L[apptOk]</div>
                }
                @if (TempData["AppointmentError"] is string apptErr)
                {
                    <div class="alert alert-danger">@L[apptErr]</div>
                }

                @* Book a viewing. Loaded lazily as a partial (open slots come from our own DB, so
                   it's quick) — kept off the initial render to keep this busy page lean. *@
                <div class="detail-section" id="appointmentBooking" data-listing-id="@listing.Id" hidden></div>

                <div class="detail-section">
                    <h3>@L["Location"]</h3>
                    <p class="addr-line">@listing.Address</p>
                    @if (listing.Latitude is not null && listing.Longitude is not null)
                    {
                        <div id="detailMap"></div>
                    }
                </div>

                @* Neighborhood decision-support, loaded lazily in two independent pieces so the fast
                   price figure never waits on the slow external POI service. Hidden until at least
                   one piece arrives — a listing with no location returns 204 for both and the block
                   never appears. *@
                <div id="neighborhoodInsights" class="detail-section" data-listing-id="@listing.Id"
                     data-error="@L["Nearby amenities couldn’t be loaded right now. Refresh to try again."]" hidden>
                    <h3>@L["Neighborhood insights"]</h3>
                    <p class="ni-note">@L["Automatic estimates from public map data and our own listings — a starting point, not a guarantee."]</p>
                    <div class="ni-grid" id="niGrid"></div>
                    <div id="niAmenities"><div class="ni-loading">@L["Loading nearby amenities…"]</div></div>
                </div>
            </div>

            <aside>
                <div class="contact-card">
                    <h3>@L["Contact the agent"]</h3>
                    <p class="sub">@L["Interested? Send a message and the agent will get back to you."]</p>
                    <form asp-action="Inquire" method="post">
                        <input type="hidden" asp-for="Inquiry.ListingId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:.8rem;"></div>

                        <div class="field-group">
                            <label asp-for="Inquiry.Name" class="form-label">@L["Name"]</label>
                            <input asp-for="Inquiry.Name" class="form-control" />
                            <span asp-validation-for="Inquiry.Name" class="text-danger"></span>
                        </div>
                        <div class="field-group">
                            <label asp-for="Inquiry.Email" class="form-label">@L["Email"]</label>
                            <input asp-for="Inquiry.Email" class="form-control" />
                            <span asp-validation-for="Inquiry.Email" class="text-danger"></span>
                        </div>
                        <div class="field-group">
                            <label asp-for="Inquiry.Phone" class="form-label">@L["Phone (optional)"]</label>
                            <input asp-for="Inquiry.Phone" class="form-control" />
                            <span asp-validation-for="Inquiry.Phone" class="text-danger"></span>
                        </div>
                        <div class="field-group">
                            <label asp-for="Inquiry.Message" class="form-label">@L["Message"]</label>
                            <textarea asp-for="Inquiry.Message" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Inquiry.Message" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary" style="width:100%;">@L["Send message"]</button>
                    </form>
                </div>
            </aside>
        </div>

        @* Discovery aid, not personalisation: these are chosen from this listing's own type,
           neighbourhood and price. Hidden entirely when nothing close enough turns up rather
           than padded with weak matches. The cards skip the save-heart — this page carries no
           AJAX favourite plumbing, and a click lands on the listing where Save lives. *@
        @if (Model.Similar.Any())
        {
            <section class="detail-section similar-listings">
                <h3>@L["Similar listings"]</h3>
                <div class="card-grid">
                    @{ ViewData["ShowFavorite"] = false; }
                    @foreach (var similar in Model.Similar)
                    {
                        <partial name="_ListingCard" model="similar" />
                    }
                </div>
            </section>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/mortgage.js" asp-append-version="true"></script>
    <script>
        function selectThumb(el){
            document.getElementById('mainImage').src = el.dataset.full;
            document.querySelectorAll('.gallery-thumbs img').forEach(function(t){t.classList.remove('active');});
            el.classList.add('active');
            el.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        }

        // Cycle prev/next through the thumbnails (wraps around at both ends).
        function stepGallery(dir){
            var thumbs = Array.prototype.slice.call(document.querySelectorAll('.gallery-thumbs img'));
            if (thumbs.length < 2) return;
            var idx = thumbs.findIndex(function(t){ return t.classList.contains('active'); });
            if (idx < 0) idx = 0;
            selectThumb(thumbs[(idx + dir + thumbs.length) % thumbs.length]);
        }

        // Left/right arrow keys navigate the gallery (unless typing in a field).
        document.addEventListener('keydown', function(e){
            if (!document.querySelector('.gallery-thumbs')) return;
            if (e.target.matches('input, textarea, select')) return;
            if (e.key === 'ArrowLeft') stepGallery(-1);
            else if (e.key === 'ArrowRight') stepGallery(1);
        });

        // Lazily load the neighborhood analysis in two independent requests. The price half is
        // pure database work (fast); the amenities half makes an external POI call (slow), so it
        // gets its own request and a loading state rather than holding up the price. The card
        // reveals as soon as either half has content; a listing with no location returns 204 for
        // both and the block stays hidden.
        (function () {
            var box = document.getElementById('neighborhoodInsights');
            if (!box) return;
            var id = encodeURIComponent(box.getAttribute('data-listing-id'));
            var lang = document.documentElement.lang;
            var grid = document.getElementById('niGrid');
            var amenitiesSlot = document.getElementById('niAmenities');

            function reveal() { box.hidden = false; }

            // Injects one partial's root nodes into a target, replacing whatever was there.
            function inject(target, html) {
                var tpl = document.createElement('template');
                tpl.innerHTML = html.trim();
                target.innerHTML = '';
                target.appendChild(tpl.content);
            }

            // Price — fast. Prepend so it sits before the walkability card in the grid.
            fetch('/' + lang + '/Listings/NeighborhoodPrice?id=' + id)
                .then(function (r) { return r.status === 200 ? r.text() : null; })
                .then(function (html) {
                    if (!html) return;
                    var tpl = document.createElement('template');
                    tpl.innerHTML = html.trim();
                    grid.insertBefore(tpl.content, grid.firstChild);
                    reveal();
                })
                .catch(function () { /* price is optional too */ });

            // Amenities — slow. Splits into the walkability card (into the grid, beside price) and
            // the amenity list / notice (below). A network failure shows the soft error notice.
            fetch('/' + lang + '/Listings/NeighborhoodAmenities?id=' + id)
                .then(function (r) { return r.status === 200 ? r.text() : (r.status === 204 ? '' : null); })
                .then(function (html) {
                    if (html === '') { amenitiesSlot.innerHTML = ''; return; } // 204: no location
                    if (html === null) throw new Error('amenities http error');
                    var tpl = document.createElement('template');
                    tpl.innerHTML = html.trim();
                    var walk = tpl.content.querySelector('.ni-walk');
                    if (walk) grid.appendChild(walk);
                    var body = tpl.content.querySelector('.ni-amenities, .ni-fail');
                    if (body) { amenitiesSlot.innerHTML = ''; amenitiesSlot.appendChild(body); }
                    else { amenitiesSlot.innerHTML = ''; }
                    reveal();
                })
                .catch(function () {
                    // Show the soft "couldn't load" notice only if the card is (or becomes) visible.
                    amenitiesSlot.innerHTML = '<p class="ni-fail">' + (box.getAttribute('data-error') || '') + '</p>';
                });
        })();

        // Lazily load the "book a viewing" panel (open slots come from our DB). Wire up slot
        // selection after injecting, since the partial's markup arrives after this script runs.
        (function () {
            var box = document.getElementById('appointmentBooking');
            if (!box) return;
            var id = encodeURIComponent(box.getAttribute('data-listing-id'));
            var lang = document.documentElement.lang;
            fetch('/' + lang + '/Appointments/Slots?listingId=' + id)
                .then(function (r) { return r.status === 200 ? r.text() : null; })
                .then(function (html) {
                    if (!html) return;
                    box.innerHTML = html;
                    box.hidden = false;
                    wireSlots(box);
                })
                .catch(function () { /* leave the panel hidden on failure */ });

            function wireSlots(root) {
                var form = root.querySelector('#apptForm');
                if (!form) return;
                var hidden = form.querySelector('#apptStart');
                var submit = form.querySelector('#apptSubmit');
                form.querySelectorAll('.appt-slot').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        form.querySelectorAll('.appt-slot').forEach(function (b) { b.classList.remove('is-selected'); });
                        btn.classList.add('is-selected');
                        hidden.value = btn.getAttribute('data-start');
                        if (submit) submit.disabled = false;
                    });
                });
            }
        })();
    </script>
    @if (listing.Latitude is not null && listing.Longitude is not null)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
            (function () {
            var lat = @listing.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var lng = @listing.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var map = L.map('detailMap').setView([lat, lng], 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19, attribution: '© OpenStreetMap contributors'
            }).addTo(map);
            L.marker([lat, lng]).addTo(map);
            })();
        </script>
    }

    @{
        var propertyTypeSchema = listing.PropertyType switch
        {
            RealEstatePortal.Domain.Enums.PropertyType.Apartment => "Apartment",
            RealEstatePortal.Domain.Enums.PropertyType.House => "House",
            _ => "Residence"
        };
        var structuredData = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = propertyTypeSchema,
            ["name"] = listing.Title,
            ["description"] = metaDescription,
            ["url"] = canonicalUrl,
            ["numberOfBedrooms"] = listing.Bedrooms,
            ["numberOfBathroomsTotal"] = listing.Bathrooms,
            ["floorSize"] = new Dictionary<string, object?>
            {
                ["@type"] = "QuantitativeValue",
                ["value"] = listing.AreaSqMeters,
                ["unitCode"] = "MTK"
            },
            ["image"] = listing.ImageUrls,
            ["offers"] = new Dictionary<string, object?>
            {
                ["@type"] = "Offer",
                ["price"] = listing.PriceAmount,
                ["priceCurrency"] = listing.PriceCurrency,
                ["availability"] = "https://schema.org/InStock"
            }
        };
        var jsonLd = System.Text.Json.JsonSerializer.Serialize(structuredData);
    }
    <script type="application/ld+json">@Html.Raw(jsonLd)</script>
}